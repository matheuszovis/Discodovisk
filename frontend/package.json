{
    "name": "discordovisk-frontend",
    "version": "1.0.27",
    "description": "Frontend do Discordovisk - Interface de usuário",
    "private": true,
    "homepage": ".",
    "scripts": {
        "start": "react-scripts start",
        "build": "react-scripts build",
        "build:icon": "node scripts/create-icon.js",
        "apply:icon": "node scripts/apply-icon.js",
        "electron:start": "npm run build && electron electron/main.js",
        "test:call": "react-scripts test --watchAll=false --runInBand --resetMocks=false --silent",
        "dist": "npm run test:call && npm run build && npm run build:icon && electron-builder --dir && npm run apply:icon && electron-builder --prepackaged dist/win-unpacked --win nsis --publish never",
        "release": "npm run test:call && npm run build && npm run build:icon && electron-builder --dir && npm run apply:icon && electron-builder --prepackaged dist/win-unpacked --win nsis --publish always",
        "test": "react-scripts test",
        "eject": "react-scripts eject"
    },
    "dependencies": {
        "axios": "^1.4.0",
        "electron-updater": "^6.8.9",
        "loopback-capture": "^3.0.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.11.0",
        "react-scripts": "5.0.1",
        "simple-peer": "^9.11.1",
        "socket.io-client": "^4.6.1"
    },
    "devDependencies": {
        "electron": "^31.7.7",
        "electron-builder": "^25.1.8",
        "png-to-ico": "^2.1.8",
        "rcedit": "^5.0.2"
    },
    "main": "electron/main.js",
    "build": {
        "extends": null,
        "appId": "com.discordovisk.app",
        "productName": "Discordovisk",
        "afterPack": "electron/afterPack.js",
        "extraMetadata": {
            "main": "electron/main.js"
        },
        "files": [
            "build/**/*",
            "electron/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "node_modules/loopback-capture/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "build/ico.ico",
            "signAndEditExecutable": false
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "runAfterFinish": true,
            "deleteAppDataOnUninstall": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "artifactName": "Discordovisk-Setup-${version}.${ext}"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "matheuszovis",
                "repo": "Discodovisk",
                "releaseType": "release"
            }
        ],
        "directories": {
            "output": "dist"
        }
    },
    "eslintConfig": {
        "extends": [
            "react-app"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
